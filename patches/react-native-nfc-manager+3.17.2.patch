@@ -218,6 +222,14 @@
 - (void)tagReaderSession:(NFCTagReaderSession *)session didInvalidateWithError:(NSError *)error
     API_AVAILABLE(ios(13.0)) {
     NSLog(@"NFCTag didInvalidateWithError");
+    // LifeTap patch: iOS reports a cancelled session as closed a moment later.
+    // If a new scan has started by then, that late report used to fail the new
+    // scan and drop its session (an NFC sheet that no longer reads tags).
+    // Reports from any session other than the current one are ignored.
+    if (session != tagSession) {
